{
  "expo": {
    "name": "Gestion solicitudes",
    "slug": "gestion-consultas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-company.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-company.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-company.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.louis3l3.gestionconsultas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d89dc8bf-a7f3-4fe6-86c6-51860f944d42"
      }
    }
  }
}
